generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core identity & profiles
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String? // null when using Keycloak
  keycloakId    String?  @unique
  fullName      String
  userType      UserType
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidateProfile     CandidateProfile?
  company              Company?
  sessions             Session[]
  applications         Application[] // candidate applications
  placements           Placement[] // recruiter placements (attributed to)
  walletTransactions   WalletTransaction[]
  workspaceMemberships WorkspaceMembership[]
  talentCandidate      Candidate? @relation("CandidateTalentAccount")
  marketplacePlacements MarketplacePlacement[] @relation("MarketplacePlacementRecruiter")
  revenueAllocations   PlacementRevenueAllocation[] @relation("PlacementRevenueAllocationRecruiter")
  invoices             Invoice[]
  nfeEmissions         NfeEmission[]
  taxDocuments         TaxDocument[]
}

enum UserType {
  candidate
  recruiter
  company
  admin
}

enum WorkspaceRole {
  owner
  admin
  recruiter
  viewer
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String // hash of JWT for invalidation
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  githubUsername       String?
  linkedinUrl          String?
  primaryStack         String?
  experienceLevel      String? // junior | mid | senior | staff
  englishLevel         String?
  salaryExpectationUsd Int?
  taxResidence         String? // brazil | argentina | mexico | other
  taxId                String? // CPF/CNPJ
  cityState            String?
  eScore               Int? // 0-100, from GitHub + salary
  speechScore          Int? // from AI assessment
  readinessScore       Int? // composite
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  website      String?
  size         String? // 1-10, 11-50, etc.
  roleTypes    String? // eng, pm, design, data
  hiringVolume String? // low, medium, high
  companyType  String // agency | company
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs         Job[]
}

// ---------------------------------------------------------------------------
// Jobs & matching
// ---------------------------------------------------------------------------

model TechStack {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id           String        @id @default(cuid())
  companyId    String
  title        String
  description  String?
  location     String?
  jobType      String // Full-time | Contract | Part-time
  salaryMinUsd Int?
  salaryMaxUsd Int?
  stack        String[] // array of tech names
  status       String        @default("open") // open | closed | filled
  postedAt     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id            String   @id @default(cuid())
  jobId         String
  candidateId   String
  status        String   @default("applied") // applied | shortlisted | rejected | hired
  eScoreAtApply Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Payments & escrow
// ---------------------------------------------------------------------------

model Placement {
  id                   String    @id @default(cuid())
  applicationId        String
  recruiterId          String? // user who gets commission (null = direct company hire)
  successFeeUsd        Float
  retentionBonusUsd    Float     @default(0)
  successFeeReleased   Boolean   @default(false)
  retentionReleased    Boolean   @default(false)
  retentionReleaseDate DateTime?
  createdAt            DateTime  @default(now())
  recruiter            User?     @relation(fields: [recruiterId], references: [id])
  escrowHolds          EscrowHold[]
  invoices             Invoice[]
  platformFees         PlatformFee[]
}

model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String
  type         String // invoice | bonus | withdrawal | success_fee | retention_bonus
  amountUsd    Float
  amountBrl    Float?
  exchangeRate Float?
  description  String?
  status       String   @default("completed") // pending | completed | failed
  referenceId  String? // external payment id
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EscrowHold {
  id          String   @id @default(cuid())
  placementId String
  amountUsd   Float
  currency    String   @default("USD")
  status      String   @default("held") // held | released | forfeited
  holdReason  String   @default("success_fee") // success_fee | retention_bonus
  heldAt      DateTime @default(now())
  releaseAt   DateTime // scheduled release date
  releasedAt  DateTime?
  createdAt   DateTime @default(now())
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([placementId, status])
  @@index([status, releaseAt])
  @@map("escrow_holds")
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  placementId     String?
  invoiceNumber   String   @unique
  amountUsd       Float
  amountBrl       Float?
  exchangeRate    Float?
  taxResidence    String?
  cnaeCode        String?
  status          String   @default("draft") // draft | issued | paid | void
  issuedAt        DateTime?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placement       Placement? @relation(fields: [placementId], references: [id], onDelete: SetNull)
  nfeEmissions    NfeEmission[]

  @@index([userId, status])
  @@index([placementId])
  @@map("invoices")
}

model PlatformFee {
  id          String   @id @default(cuid())
  placementId String
  feeType     String   // success_fee | retention_mgmt | latam_tax_bridge
  amountUsd   Float
  basisPoints Int      // e.g. 2000 = 20%
  status      String   @default("pending") // pending | deducted
  createdAt   DateTime @default(now())
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([placementId, feeType])
  @@map("platform_fees")
}

model NfeEmission {
  id                  String   @id @default(cuid())
  invoiceId           String
  userId              String
  nfeNumber           String?  @unique
  nfeKey              String?  // Chave de Acesso (43 digits)
  provider            String   @default("focus_nfe")
  providerNfeId       String?  // External provider reference
  status              String   @default("pending") // pending | processing | authorized | rejected | cancelled | error
  rejectionReason     String?
  cnaeCode            String
  serviceDescription  String
  amountUsd           Float
  amountBrl           Float
  exchangeRate        Float
  exchangeRateSource  String   @default("frankfurter")
  taxResidence        String?
  taxRegime           String?  // simples_nacional | lucro_presumido | mei
  issExempt           Boolean  @default(false)
  protocolNumber      String?  // Authorization protocol from Receita Federal
  authorizedAt        DateTime?
  cancelledAt         DateTime?
  xmlUri              String?  // S3/CDN URI for NF-e XML
  pdfUri              String?  // S3/CDN URI for NF-e DANFE PDF
  emittedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([invoiceId])
  @@index([providerNfeId])
  @@map("nfe_emissions")
}

model TaxDocument {
  id              String   @id @default(cuid())
  userId          String
  documentType    String   // w8ben | w9 | other
  formType        String   @default("w8ben")
  status          String   @default("active") // active | expired | superseded | pending_review
  fullName        String
  countryOfBirth  String?
  permanentAddress String?
  mailingAddress  String?
  taxId           String?  // SSN or ITIN for W-8BEN, EIN for W-9
  dateOfBirth     DateTime?
  isForeignIndividual Boolean @default(true)
  claimTreatyBenefits Boolean @default(false)
  treatyCountry   String?
  treatyArticle   String?
  documentUri     String?  // S3/CDN URI for uploaded signed form
  signatureDate   DateTime?
  expiryDate      DateTime? // W-8BEN expires after 3 years
  renewalAlertSent Boolean @default(false)
  supersededById  String?
  metadata        Json?    // Additional form fields
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, formType])
  @@index([expiryDate])
  @@map("tax_documents")
}

model ExchangeRateLog {
  id        Int      @id @default(autoincrement())
  fromCur   String   @default("USD")
  toCur     String   @default("BRL")
  rate      Float
  source    String? // api | env
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Market data for E-Score
// ---------------------------------------------------------------------------

model MarketRate {
  id           Int      @id @default(autoincrement())
  roleLabel    String // e.g. "Senior Backend"
  salaryAvgUsd Float
  currency     String   @default("USD")
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Email & verification
// ---------------------------------------------------------------------------

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Blinkfy multi-tenant workspace and audit data
// ---------------------------------------------------------------------------

model Workspace {
  id          String                @id @default(cuid())
  name        String
  clients     Client[]
  memberships WorkspaceMembership[]
  auditEvents AuditEvent[]
  candidates  Candidate[]
  consents    CandidateConsent[]
  imports     CandidateImport[]
  marketplacePlacements MarketplacePlacement[]
  revenueAllocations PlacementRevenueAllocation[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplacePlacements MarketplacePlacement[] @relation("MarketplacePlacementRecruiterMembership")
  revenueAllocations PlacementRevenueAllocation[] @relation("PlacementRevenueAllocationRecruiterMembership")

  @@unique([workspaceId, userId])
}

model Client {
  id               String                 @id @default(cuid())
  workspaceId      String
  name             String
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs             BlinkfyJob[]
  jobImports       JobImport[]
  candidateImports CandidateImport[]
  consents         CandidateConsent[]
  applications     CandidateApplication[]
  marketplacePlacements MarketplacePlacement[]
  revenueAllocations PlacementRevenueAllocation[]
  knowledgeDocuments KnowledgeDocument[]
  conciergeSchedulingPolicy ConciergeSchedulingPolicy?
  conciergeWebhookSubscription ConciergeWebhookSubscription?
  conciergeWebhookOutbox ConciergeWebhookOutbox[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([workspaceId, id], map: "clients_workspace_id_key")
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String?
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

enum TalentJobStatus {
  draft
  open
  closed

  @@map("talent_job_status")
}

enum JobImportStatus {
  completed
  failed
}

model BlinkfyJob {
  id           String                 @id @default(cuid())
  clientId     String
  title        String
  description  String?
  location     String?
  workModel    String?
  salaryMin    Int?
  salaryMax    Int?
  requirements Json
  status       TalentJobStatus        @default(draft)
  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scorecard    JobScorecard?
  applications CandidateApplication[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([clientId, status])
  @@map("talent_jobs")
}

model JobScorecard {
  id          String     @id @default(cuid())
  jobId       String     @unique
  skills      Int
  experience  Int
  context     Int
  preferences Int
  signals     Int
  policyVersion String @default("fit-score-v1")
  job         BlinkfyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("job_scorecards")
}

model JobImport {
  id        String          @id @default(cuid())
  clientId  String
  status    JobImportStatus
  rowNumber Int
  source    Json
  errors    Json?
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([clientId, createdAt])
  @@map("job_imports")
}

enum CandidateImportStatus {
  completed
  completed_with_errors
  failed
}

model Candidate {
  id                    String                 @id @default(cuid())
  workspaceId           String
  fullName              String
  normalizedEmail       String?
  normalizedLinkedinUrl String?
  profile               Json
  sourceMetadata        Json?
  userId                String?                @unique
  visibility            CandidateVisibility   @default(private)
  targetRole            String?
  headline              String?
  bio                   String?
  skills                String[]               @default([])
  location              String?
  workModel             String?
  availability          String?
  portfolioUrl          String?
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User?                  @relation("CandidateTalentAccount", fields: [userId], references: [id], onDelete: SetNull)
  identities            CandidateIdentity[]
  consents              CandidateConsent[]
  applications          CandidateApplication[]
  subscription          CandidateSubscription?
  usage                 CandidateUsage[]
  drafts                CandidateDraft[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([workspaceId])
  @@map("candidates")
}

enum CandidatePlan {
  free
  pro
}

enum CandidateSubscriptionStatus {
  active
  trialing
  past_due
  canceled
  expired
}

model CandidateSubscription {
  id                    String                     @id @default(cuid())
  candidateId           String                     @unique
  plan                  CandidatePlan              @default(free)
  status                CandidateSubscriptionStatus @default(active)
  provider              String?
  providerCustomerId    String?
  providerSubscriptionId String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  candidate             Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_subscriptions")
}

model CandidateUsage {
  id          String   @id @default(cuid())
  candidateId String
  period      String
  feature     String
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, period, feature])
  @@index([candidateId, period])
  @@map("candidate_usage")
}

enum CandidateVisibility {
  private
  available
  recruiters_only
  paused

  @@map("candidate_visibility")
}

model CandidateIdentity {
  id              String           @id @default(cuid())
  candidateId     String
  importId        String?
  source          String
  externalId      String?
  sourceMetadata  Json?
  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateImport CandidateImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@index([candidateId, source])
  @@index([importId])
  @@map("candidate_identities")
}

model CandidateConsent {
  id          String    @id @default(cuid())
  candidateId String
  workspaceId String
  clientId    String?
  purpose     String
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  evidence    String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([candidateId, purpose, clientId, revokedAt])
  @@index([workspaceId, purpose])
  @@map("candidate_consents")
}

model CandidateImport {
  id             String                @id @default(cuid())
  workspaceId    String
  clientId       String
  filename       String
  source         String
  status         CandidateImportStatus
  createdCount   Int                   @default(0)
  duplicateCount Int                   @default(0)
  invalidCount   Int                   @default(0)
  errors         Json?
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  identities     CandidateIdentity[]
  createdAt      DateTime              @default(now())

  @@index([workspaceId, createdAt])
  @@index([clientId, createdAt])
  @@map("candidate_imports")
}

model CandidateApplication {
  id             String             @id @default(cuid())
  candidateId    String
  clientId       String
  jobId          String?
  stage          ApplicationStage   @default(mapped)
  mappedAt       DateTime           @default(now())
  reviewedAt     DateTime?
  interestedAt   DateTime?
  screenedAt     DateTime?
  shortlistedAt  DateTime?
  hiredAt        DateTime?
  rejectedAt     DateTime?
  candidate      Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job            BlinkfyJob?        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scoreSnapshots FitScoreSnapshot[]
  screeningSessions ScreeningSession[]
  screeningFeedback ScreeningFeedback[]
  messageSuggestions MessageSuggestion[]
  conciergeMessages ConciergeMessage[]
  followUpSequence ConciergeFollowUpSequence?
  marketplacePlacement MarketplacePlacement?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([candidateId, jobId])
  @@unique([clientId, id], map: "candidate_applications_client_id_key")
  @@index([clientId, stage])
  @@index([jobId, stage])
  @@map("candidate_applications")
}

enum MessageSuggestionStatus {
  draft
  approved
  rejected
}

model MessageSuggestion {
  id            String                  @id @default(cuid())
  applicationId String
  channel       String                  // linkedin | email | whatsapp
  content       String
  status        MessageSuggestionStatus @default(draft)
  approvedAt    DateTime?
  approvedById  String?
  sourceMessageId String?
  grounding     Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  application   CandidateApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sourceMessage ConciergeMessage?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([applicationId, status, createdAt])
  @@map("message_suggestions")
}

model ConciergeMessage {
  id                String                @id @default(cuid())
  applicationId     String
  externalMessageId String                @unique
  channel           String
  direction         String                @default("inbound")
  content           String
  receivedAt        DateTime              @default(now())
  application       CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  suggestions       MessageSuggestion[]
  @@index([applicationId, receivedAt])
  @@map("concierge_messages")
}

enum CandidateDraftStatus {
  pending
  approved
  rejected
}

model CandidateDraft {
  id          String              @id @default(cuid())
  candidateId String
  kind        String
  payload     Json
  status      CandidateDraftStatus @default(pending)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  candidate   Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@map("candidate_drafts")
}

model ConciergeFollowUpSequence {
  id            String   @id @default(cuid())
  applicationId String   @unique
  delaysInDays  Json
  status        String   @default("active")
  interruptedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  application   CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@map("concierge_follow_up_sequences")
}

model ConciergeWebhookSubscription {
  id        String   @id @default(cuid())
  clientId  String   @unique
  url       String
  secret    String
  events    Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@map("concierge_webhook_subscriptions")
}

model ConciergeWebhookOutbox {
  id        String   @id @default(cuid())
  clientId  String
  eventId   String
  eventType String
  signature String
  status    String   @default("pending_approval")
  createdAt DateTime @default(now())
  approvedAt DateTime?
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@unique([clientId, eventId])
  @@index([clientId, status, createdAt])
  @@map("concierge_webhook_outbox")
}

model KnowledgeDocument {
  id        String            @id @default(cuid())
  clientId  String
  title     String
  source    String            @default("manual")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]
  @@unique([clientId, title])
  @@index([clientId, createdAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  position   Int
  content    String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, position])
  @@map("knowledge_chunks")
}

model ConciergeSchedulingPolicy {
  id        String   @id @default(cuid())
  clientId  String   @unique
  timezone  String
  windows   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@map("concierge_scheduling_policies")
}

enum ScreeningSessionStatus {
  invited
  consented
  scheduled
  in_progress
  completed
  withdrawn
}

model ScreeningSession {
  id              String                 @id @default(cuid())
  applicationId   String
  status          ScreeningSessionStatus @default(invited)
  consentedAt     DateTime?
  consentVersion  String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  withdrawnAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  application     CandidateApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evidences       ScreeningEvidence[]
  webhookEvents   ScreeningWebhookEvent[]

  @@index([applicationId, status])
  @@map("screening_sessions")
}

model ScreeningWebhookEvent {
  id          String           @id @default(cuid())
  eventId     String           @unique
  sessionId   String
  receivedAt  DateTime         @default(now())
  session     ScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, receivedAt])
  @@map("screening_webhook_events")
}

enum ScreeningEvidenceKind {
  recording
  transcript
  insight
}

model ScreeningEvidence {
  id               String               @id @default(cuid())
  sessionId        String
  kind             ScreeningEvidenceKind
  uri              String?
  content          String?
  confidence       Int?
  retentionUntil   DateTime?
  createdAt        DateTime             @default(now())
  session          ScreeningSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, kind])
  @@index([retentionUntil])
  @@map("screening_evidences")
}

enum ScreeningFeedbackStatus {
  positive
  neutral
  negative
  needs_review
}

model ScreeningFeedback {
  id            String                  @id @default(cuid())
  applicationId String
  reviewerId    String
  status        ScreeningFeedbackStatus
  note          String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  application   CandidateApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("screening_feedback")
}

enum ApplicationStage {
  mapped
  reviewed
  interested
  screened
  shortlisted
  hired
  rejected
}

enum MarketplacePlacementStatus {
  confirmed

  @@map("marketplace_placement_status")
}

enum RevenueAllocationStatus {
  pending
  available
  reversed

  @@map("revenue_allocation_status")
}

enum RevenueLedgerEntryKind {
  allocation
  reversal

  @@map("revenue_ledger_entry_kind")
}

model MarketplacePlacement {
  id                    String                     @id @default(cuid())
  workspaceId           String
  clientId              String
  applicationId         String                     @unique(map: "marketplace_placements_application_key")
  recruiterUserId       String
  status                MarketplacePlacementStatus @default(confirmed)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  workspace             Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "marketplace_placements_workspace_fkey")
  client                Client                     @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "marketplace_placements_workspace_client_fkey")
  application           CandidateApplication       @relation(fields: [clientId, applicationId], references: [clientId, id], onDelete: Restrict, onUpdate: NoAction, map: "marketplace_placements_client_application_fkey")
  recruiter             User                       @relation("MarketplacePlacementRecruiter", fields: [recruiterUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "marketplace_placements_recruiter_user_fkey")
  recruiterMembership   WorkspaceMembership        @relation("MarketplacePlacementRecruiterMembership", fields: [workspaceId, recruiterUserId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: NoAction, map: "marketplace_placements_workspace_recruiter_fkey")
  allocation            PlacementRevenueAllocation?

  @@unique([clientId, applicationId], map: "marketplace_placements_client_application_key")
  @@unique([workspaceId, clientId, recruiterUserId, id], map: "marketplace_placements_tenant_id_key")
  @@index([workspaceId, clientId, createdAt])
  @@index([recruiterUserId, createdAt])
  @@map("marketplace_placements")
}

model PlacementRevenueAllocation {
  id                    String                  @id @default(cuid())
  workspaceId           String
  clientId              String
  placementId           String                  @unique(map: "revenue_allocations_placement_key")
  recruiterUserId       String
  currency              String                  @db.Char(3)
  grossAmountMinor      Int
  recruiterBasisPoints  Int                     @default(7000)
  platformBasisPoints   Int                     @default(3000)
  recruiterAmountMinor  Int
  platformAmountMinor   Int
  status                RevenueAllocationStatus @default(pending)
  availableAt           DateTime?
  reversedAt            DateTime?
  createdAt             DateTime                @default(now())
  workspace             Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "revenue_allocations_workspace_fkey")
  client                Client                  @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "revenue_allocations_workspace_client_fkey")
  placement             MarketplacePlacement    @relation(fields: [workspaceId, clientId, recruiterUserId, placementId], references: [workspaceId, clientId, recruiterUserId, id], onDelete: Restrict, onUpdate: NoAction, map: "revenue_allocations_placement_tenant_fkey")
  recruiter             User                    @relation("PlacementRevenueAllocationRecruiter", fields: [recruiterUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "revenue_allocations_recruiter_user_fkey")
  recruiterMembership   WorkspaceMembership     @relation("PlacementRevenueAllocationRecruiterMembership", fields: [workspaceId, recruiterUserId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: NoAction, map: "revenue_allocations_workspace_recruiter_fkey")
  ledgerEntries         PlacementRevenueLedgerEntry[]

  @@unique([workspaceId, clientId, recruiterUserId, placementId], map: "revenue_allocations_placement_tenant_key")
  @@unique([id, currency], map: "revenue_allocations_id_currency_key")
  @@index([workspaceId, clientId, createdAt], map: "revenue_allocations_workspace_client_created_idx")
  @@index([recruiterUserId, createdAt])
  @@map("placement_revenue_allocations")
}

model PlacementRevenueLedgerEntry {
  id                    String                  @id @default(cuid())
  allocationId          String
  kind                  RevenueLedgerEntryKind
  recruiterAmountMinor  Int
  platformAmountMinor   Int
  currency              String                  @db.Char(3)
  createdAt             DateTime                @default(now())
  allocation            PlacementRevenueAllocation @relation(fields: [allocationId, currency], references: [id, currency], onDelete: Restrict, onUpdate: NoAction, map: "revenue_ledger_allocation_currency_fkey")

  @@unique([allocationId, kind], map: "revenue_ledger_allocation_kind_key")
  @@index([createdAt])
  @@map("placement_revenue_ledger_entries")
}

enum FitScoreConfidence {
  low
  medium
  high
}

model FitScoreSnapshot {
  id               String               @id @default(cuid())
  applicationId    String
  score            Int
  confidence       FitScoreConfidence
  policyVersion    String
  factors          Json
  gaps             Json
  computedAt       DateTime             @default(now())
  overrideScore    Int?
  overrideReason   String?
  overrideByUserId String?
  overriddenAt     DateTime?
  application      CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, computedAt])
  @@map("fit_score_snapshots")
}
