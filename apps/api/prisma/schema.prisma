generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core identity & profiles
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String? // null when using Keycloak
  keycloakId    String?  @unique
  fullName      String
  userType      UserType
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidateProfile     CandidateProfile?
  company              Company?
  sessions             Session[]
  applications         Application[] // candidate applications
  placements           Placement[] // recruiter placements (attributed to)
  walletTransactions   WalletTransaction[]
  workspaceMemberships WorkspaceMembership[]
}

enum UserType {
  candidate
  recruiter
  company
  admin
}

enum WorkspaceRole {
  owner
  admin
  recruiter
  viewer
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String // hash of JWT for invalidation
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  githubUsername       String?
  linkedinUrl          String?
  primaryStack         String?
  experienceLevel      String? // junior | mid | senior | staff
  englishLevel         String?
  salaryExpectationUsd Int?
  taxResidence         String? // brazil | argentina | mexico | other
  taxId                String? // CPF/CNPJ
  cityState            String?
  eScore               Int? // 0-100, from GitHub + salary
  speechScore          Int? // from AI assessment
  readinessScore       Int? // composite
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  website      String?
  size         String? // 1-10, 11-50, etc.
  roleTypes    String? // eng, pm, design, data
  hiringVolume String? // low, medium, high
  companyType  String // agency | company
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs         Job[]
}

// ---------------------------------------------------------------------------
// Jobs & matching
// ---------------------------------------------------------------------------

model TechStack {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id           String        @id @default(cuid())
  companyId    String
  title        String
  description  String?
  location     String?
  jobType      String // Full-time | Contract | Part-time
  salaryMinUsd Int?
  salaryMaxUsd Int?
  stack        String[] // array of tech names
  status       String        @default("open") // open | closed | filled
  postedAt     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id            String   @id @default(cuid())
  jobId         String
  candidateId   String
  status        String   @default("applied") // applied | shortlisted | rejected | hired
  eScoreAtApply Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Payments & escrow
// ---------------------------------------------------------------------------

model Placement {
  id                   String    @id @default(cuid())
  applicationId        String
  recruiterId          String? // user who gets commission (null = direct company hire)
  successFeeUsd        Float
  retentionBonusUsd    Float     @default(0)
  successFeeReleased   Boolean   @default(false)
  retentionReleased    Boolean   @default(false)
  retentionReleaseDate DateTime?
  createdAt            DateTime  @default(now())
  recruiter            User?     @relation(fields: [recruiterId], references: [id])
}

model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String
  type         String // invoice | bonus | withdrawal | success_fee | retention_bonus
  amountUsd    Float
  amountBrl    Float?
  exchangeRate Float?
  description  String?
  status       String   @default("completed") // pending | completed | failed
  referenceId  String? // external payment id
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExchangeRateLog {
  id        Int      @id @default(autoincrement())
  fromCur   String   @default("USD")
  toCur     String   @default("BRL")
  rate      Float
  source    String? // api | env
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Market data for E-Score
// ---------------------------------------------------------------------------

model MarketRate {
  id           Int      @id @default(autoincrement())
  roleLabel    String // e.g. "Senior Backend"
  salaryAvgUsd Float
  currency     String   @default("USD")
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Email & verification
// ---------------------------------------------------------------------------

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Blinkfy multi-tenant workspace and audit data
// ---------------------------------------------------------------------------

model Workspace {
  id          String                @id @default(cuid())
  name        String
  clients     Client[]
  memberships WorkspaceMembership[]
  auditEvents AuditEvent[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Client {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs        BlinkfyJob[]
  jobImports  JobImport[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String?
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

enum TalentJobStatus {
  draft
  open
  closed

  @@map("talent_job_status")
}

enum JobImportStatus {
  completed
  failed
}

model BlinkfyJob {
  id           String          @id @default(cuid())
  clientId     String
  title        String
  description  String?
  location     String?
  workModel    String?
  salaryMin    Int?
  salaryMax    Int?
  requirements Json
  status       TalentJobStatus @default(draft)
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scorecard    JobScorecard?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([clientId, status])
  @@map("talent_jobs")
}

model JobScorecard {
  id          String     @id @default(cuid())
  jobId       String     @unique
  skills      Int
  experience  Int
  context     Int
  preferences Int
  signals     Int
  job         BlinkfyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("job_scorecards")
}

model JobImport {
  id        String          @id @default(cuid())
  clientId  String
  status    JobImportStatus
  rowNumber Int
  source    Json
  errors    Json?
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([clientId, createdAt])
  @@map("job_imports")
}
