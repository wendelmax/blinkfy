# API
PORT=3001
NODE_ENV=production
DATABASE_URL=postgresql://user:pass@host:5432/db
# Never point automated tests at the development database.
TEST_DATABASE_URL=postgresql://admin:password@localhost:5433/blinkfy_test
JWT_SECRET=your-secret-min-32-chars-for-production
JWT_EXPIRES=7d
FRONTEND_URL=https://your-frontend.com
CORS_ORIGIN=https://your-frontend.com

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=NewOne <noreply@yourdomain.com>

# Optional
EXCHANGE_RATE=5.5
# Optional overrides for the Argentina exchange-rate lookup (URL override / fallback rate)
EXCHANGE_RATE_API_ARS=
EXCHANGE_RATE_ARS=
# Optional overrides for the Mexico exchange-rate lookup (URL override / fallback rate)
EXCHANGE_RATE_API_MXN=
EXCHANGE_RATE_MXN=
GITHUB_TOKEN=
TASKLETS_MAX_WORKERS=auto
