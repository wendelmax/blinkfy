# Docker Compose builds API and web from the repository root.
.git
.superpowers

# Dependency trees and local build/test artifacts are recreated in image stages.
node_modules
**/node_modules
.next
**/.next
dist
**/dist
coverage
**/coverage

# Never copy local environment files or logs into an image build context.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.log
**/*.log
